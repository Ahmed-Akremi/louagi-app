# ─────────────────────────────────────────────────────────────────────────
# Louagi Admin Web — environment configuration
# Copy to `.env.local` and adjust. `.env.local` is gitignored.
# ─────────────────────────────────────────────────────────────────────────

# Backend base URL as reached FROM THE BROWSER (client-side data calls hit
# `${NEXT_PUBLIC_API_URL}/graphql` directly with a Bearer access token).
# The backend's CORS_ORIGINS must include this app's origin (see README).
# Production: the admin API hostname (e.g. https://admin-api.louagi.com), which
# goes through the API gateway Worker. Admin tokens are rejected on the mobile
# API hostname once the backend's GATEWAY_SECRET is set.
NEXT_PUBLIC_API_URL=http://localhost:3000

# Backend base URL as reached FROM THE NEXT.JS SERVER (the BFF auth routes in
# /api/auth/* proxy login + token refresh server-side). Usually identical to
# NEXT_PUBLIC_API_URL. In production it can be the mobile API hostname (e.g.
# https://api.louagi.com): these calls carry no admin token, and it keeps
# Vercel's dynamic egress IPs out of infra's admin_allowed_ips.
API_URL=http://localhost:3000

# Name of the httpOnly cookie that stores the refresh token (set by the BFF).
REFRESH_COOKIE_NAME=louagi_admin_rt

# Set to "true" to mark the refresh cookie Secure (HTTPS only). Leave unset in
# local http development; set to true in any HTTPS deployment.
# COOKIE_SECURE=true
